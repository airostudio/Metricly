# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/skillassess
MONGODB_TEST_URI=mongodb://localhost:27017/skillassess_test

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=24h

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Assessment Configuration
QUESTION_TIME_LIMIT=900
TOTAL_TIME_LIMIT=7200
ENABLE_VIDEO_PROCTORING=true
ENABLE_AI_DETECTION=true
STRICT_MODE=true

# Email Configuration (for sending results)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend URL
FRONTEND_URL=http://localhost:5500

# Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
